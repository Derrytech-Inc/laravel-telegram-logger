{
    "name": "derrytech/telegram-logger",
    "description": "A self-configuring Laravel package for Telegram logging.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Derrick Azaglo",
            "email": "de.azaglo@gmail.com",
            "homepage": "https://github.com/de-azaglo/",
            "role": "Developer"
        },
        {
            "name": "Derrytech Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Derrytech\\TelegramLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derrytech\\TelegramLogger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Derrytech\\TelegramLogger\\TelegramLoggingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false,
                "ignore": [
                    "laravel/framework"
                ]
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}